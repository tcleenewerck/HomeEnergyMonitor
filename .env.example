# SolarEdge credentials
SOLAREDGE_SITE_ID=123456
SOLAREDGE_API_KEY=replace-me

# Monitor cadence
POLL_INTERVAL_SECONDS=60

# Alert thresholds. Leave empty to disable a condition.
MAX_GRID_IMPORT_W=5000
MAX_GRID_EXPORT_W=
MIN_PV_PRODUCTION_W=
BATTERY_CAPACITY_KWH=10
BATTERY_FULL_NOTICE_MINUTES=5
MIN_BATTERY_CHARGE_RATE_W=250

# Prevent repeating the same alert too often.
ALERT_COOLDOWN_SECONDS=900

# Optional SMS alerts through Twilio.
SMS_ALERTS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
ALERT_TO_PHONE_NUMBER=

# Optional Slack alerts through an incoming webhook.
SLACK_ALERTS_ENABLED=false
SLACK_WEBHOOK_URL=

# Optional daily Slack heartbeat. Use a separate webhook to choose another channel.
HEARTBEAT_ENABLED=false
HEARTBEAT_HOUR=8
HEARTBEAT_TIMEZONE=Europe/Brussels
HEARTBEAT_SLACK_WEBHOOK_URL=
